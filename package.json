{
  "name": "fit-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "체형 기반 사이즈·핏 판단 도우미 프로토타입 (14일 검증용 데모)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:file": "vite build --mode file",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs && node scripts/smokeImageSearch.mjs",
    "validate:fit": "node scripts/validateFit.mjs",
    "eval:fit": "node scripts/evalFit.mjs",
    "validate:body": "node scripts/validateBody.mjs",
    "build:extension": "node scripts/buildExtension.mjs && node scripts/checkExtension.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.10",
    "esbuild": "0.21.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.10"
  }
}
