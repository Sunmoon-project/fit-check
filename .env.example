# AI 가상 피팅은 Hugging Face Space(IDM-VTON)를 무료로 써요. 아무것도 넣지 않아도 동작해요.
# 이 파일을 .env 로 복사한 뒤 필요한 값만 넣으세요. .env 는 git에 올라가지 않습니다.

# 선택: 무료 Hugging Face 토큰 (https://huggingface.co/settings/tokens)
# 넣으면 하루 무료 GPU(ZeroGPU) 사용량이 약 2분에서 약 5분으로 늘어나요. 서버에서만 쓰고 브라우저로 보내지 않아요.
HF_TOKEN=

# 선택: 사용할 Space (기본 yisol/IDM-VTON)
# 같은 API를 쓰는 대안: John6666/IDM-VTON, LPDoctor/IDM-VTON-demo, jjlealse/IDM-VTON
HF_SPACE=yisol/IDM-VTON

# 선택: 사진 역검색(중고 상품 분석). 둘 다 넣어야 켜져요. 서버에서만 읽고 브라우저로 보내지 않아요.
# 현재 연결된 공급자 이름: google-vision (Google Cloud Vision Web Detection, 실제 API로 확인하지 못한 미검증 어댑터)
# 켜면 사용자가 버튼을 누를 때 판매글 사진 주소가 그 외부 서비스로 전송돼요.
IMAGE_SEARCH_PROVIDER=
IMAGE_SEARCH_API_KEY=
